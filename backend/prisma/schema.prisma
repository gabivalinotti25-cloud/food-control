generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(EMPLEADO)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  auditorias AuditoriaAcciones[]
  
  @@index([negocioId])
}


enum Rol {
  ADMIN
  EMPLEADO
}

enum PlanSuscripcion {
  GRATIS
  BASICO
  PRO
  ENTERPRISE
}

enum EstadoNegocio {
  ACTIVO
  SUSPENDIDO
  CANCELADO
}

enum EstadoSuscripcion {
  ACTIVA
  CANCELADA
  VENCIDA
  PRUEBA
}

enum MetodoPago {
  TARJETA
  TRANSFERENCIA
  EFECTIVO
  MERCADOPAGO
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
  VENCIDA
  ANULADA
}

enum EstadoOnboarding {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  OMITIDO
}

model Suscripcion {
  id              Int      @id @default(autoincrement())
  plan            PlanSuscripcion
  estado          EstadoSuscripcion @default(PRUEBA)
  metodoPago      MetodoPago?
  precioMensual   Int      @default(0)
  fechaInicio     DateTime @default(now())
  fechaVencimiento DateTime?
  fechaCancelacion DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  negocioId Int
  negocio   Negocio @relation(fields: [negocioId], references: [id])

  facturas Factura[]

  @@index([negocioId])
  @@index([estado])
}

model Factura {
  id          Int      @id @default(autoincrement())
  numero      String   @unique
  monto       Int
  impuestos   Int      @default(0)
  total       Int
  estado      EstadoFactura @default(PENDIENTE)
  fechaEmision DateTime @default(now())
  fechaVencimiento DateTime
  fechaPago   DateTime?
  metodoPago  MetodoPago?
  concepto    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  negocioId Int
  negocio   Negocio @relation(fields: [negocioId], references: [id])

  suscripcionId Int?
  suscripcion   Suscripcion? @relation(fields: [suscripcionId], references: [id])

  @@index([negocioId])
  @@index([estado])
}

model Onboarding {
  id          Int      @id @default(autoincrement())
  estado      EstadoOnboarding @default(PENDIENTE)
  pasoActual  Int      @default(0)
  pasosCompletados Json   @default("[]")
  iniciadoAt  DateTime @default(now())
  completadoAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  negocioId Int     @unique
  negocio   Negocio @relation(fields: [negocioId], references: [id])
}


model Negocio {
  id              Int      @id @default(autoincrement())
  nombre          String
  slug            String   @unique // URL personalizada: mi-negocio.food-control.com
  email           String   @unique
  telefono        String?
  direccion       String?
  plan            PlanSuscripcion @default(GRATIS)
  estado          EstadoNegocio @default(ACTIVO)
  
  // Límites del plan
  maxUsuarios     Int      @default(3)
  maxClientes     Int      @default(50)
  maxPedidosMes   Int      @default(100)
  maxSebastianMsg Int      @default(20)
  
  // Configuración
  whatsappNumero String?
  whatsappApiKey String?
  
  // Personalización (white-label)
  logoUrl         String?
  colorPrimario   String   @default("#3B82F6")
  colorSecundario String  @default("#1E40AF")
  dominioCustom   String?
  
  // Fechas
  trialEndsAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relaciones
  usuarios        Usuario[]
  clientes        Cliente[]
  productos       Producto[]
  pedidos         Pedido[]
  movimientosCuenta MovimientoCuenta[]
  ventasAnonimas  VentaAnonima[]
  menusPlantilla  MenuPlantilla[]
  menusDiarios    MenuDiario[]
  cajasDiarias    CajaDiaria[]
  configuracionesMenu ConfiguracionMenu[]
  propuestasSebastian PropuestaSebastian[]
  notificaciones  Notificacion[]
  historialConversacion HistorialConversacion[]
  auditorias      AuditoriaAcciones[]
  suscripciones   Suscripcion[]
  facturas        Factura[]
  onboarding      Onboarding?
  categorias      Categoria[]
  
  @@index([slug])
  @@index([estado])
  @@index([plan])
}


model Cliente {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String
  direccion   String?
  observacion String?
  saldo       Int      @default(0)
  createdAt   DateTime @default(now())

  negocioId   Int      @default(1) // Valor por defecto para migración
  negocio     Negocio @relation(fields: [negocioId], references: [id])

  pedidos      Pedido[]
  movimientos  MovimientoCuenta[]
  
  @@unique([negocioId, telefono])
  @@index([negocioId])
}


model Categoria {
  id        Int      @id @default(autoincrement())
  nombre    String
  createdAt DateTime @default(now())

  negocioId Int      @default(1)
  negocio   Negocio  @relation(fields: [negocioId], references: [id])

  @@index([negocioId])
}


model Producto {
  id         Int      @id @default(autoincrement())

  nombre     String
  precio     Int

  activo     Boolean  @default(true)

  orden      Int      @default(0)

  esLibre    Boolean  @default(false)

  esFijo     Boolean  @default(false)
  
  esEspecial Boolean  @default(false)

  createdAt  DateTime @default(now())

  negocioId  Int      @default(1) // Valor por defecto para migración
  negocio    Negocio @relation(fields: [negocioId], references: [id])

  detallesPedido PedidoDetalle[]
  menus MenuPlantillaDetalle[]
  menusDiarios MenuDiarioDetalle[]
  
  @@index([negocioId])
}

model Pedido {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @default(now())
  total     Int

  estado      PedidoEstado @default(PENDIENTE)
  estadoPago  EstadoPago  @default(PENDIENTE)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])

  pago     Pago?
  detalles PedidoDetalle[]
  
  @@index([negocioId])
}


model PedidoDetalle {
  id Int @id @default(autoincrement())

  pedidoId Int
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId Int?
  producto Producto? @relation(fields: [productoId], references: [id])

  descripcion String?

  cantidad Int

  precioUnitario Int

  subtotal Int
}


model Pago {
  id Int @id @default(autoincrement())

  monto Int

  forma FormaPago

  fechaPago DateTime @default(now())

  pedidoId Int @unique
  pedido Pedido @relation(fields: [pedidoId], references: [id])
}


enum EstadoPago {
  PENDIENTE
  PAGADO
}


enum FormaPago {
  EFECTIVO
  TRANSFERENCIA
}


enum PedidoEstado {
  PENDIENTE
  PREPARANDO
  EN_CAMINO
  ENTREGADO
}


model MovimientoCuenta {
  id Int @id @default(autoincrement())

  fecha DateTime @default(now())

  tipo TipoMovimiento

  concepto String

  monto Int

  formaPago FormaPago?

  clienteId Int
  cliente Cliente @relation(fields: [clienteId], references: [id])

  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  @@index([negocioId])
}


enum TipoMovimiento {
  CARGO
  ABONO
}


model MenuPlantilla {
  id Int @id @default(autoincrement())

  diaSemana Int

  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])

  productos MenuPlantillaDetalle[]
  
  @@index([negocioId])
}


model MenuPlantillaDetalle {
  id Int @id @default(autoincrement())

  menuId Int
  menu MenuPlantilla @relation(fields: [menuId], references: [id], onDelete: Cascade)

  productoId Int
  producto Producto @relation(fields: [productoId], references: [id])
}


model MenuDiario {
  id Int @id @default(autoincrement())

  fecha DateTime

  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])

  productos MenuDiarioDetalle[]
  
  @@unique([negocioId, fecha])
  @@index([negocioId])
}


model MenuDiarioDetalle {
  id Int @id @default(autoincrement())

  menuId Int
  menu MenuDiario @relation(fields: [menuId], references: [id], onDelete: Cascade)

  productoId Int
  producto Producto @relation(fields: [productoId], references: [id])
}


model VentaAnonima {
  id Int @id @default(autoincrement())
  
  monto Int
  descripcion String?
  formaPago FormaPago
  fecha DateTime @default(now())
  
  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  @@index([negocioId])
}


model CajaDiaria {
  id Int @id @default(autoincrement())
  
  fecha DateTime
  
  montoEfectivoEsperado Int @default(0)
  montoTransferenciaEsperado Int @default(0)
  montoEfectivoReal Int @default(0)
  montoTransferenciaReal Int @default(0)
  
  observacion String?
  cerrada Boolean @default(false)
  fechaCierre DateTime?
  
  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([negocioId, fecha])
  @@index([negocioId])
}


model ConfiguracionMenu {
  id Int @id @default(autoincrement())
  
  diaSemana Int // 0 = Domingo, 1 = Lunes, etc.
  
  productosFijos Boolean @default(true)
  cantidadMaxEspeciales Int @default(2)
  
  activo Boolean @default(true)
  
  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([negocioId])
}


model PropuestaSebastian {
  id              Int      @id @default(autoincrement())
  mensajeOriginal String
  origen          String
  accion          String
  descripcion     String
  datos           Json
  confianza       Float
  estado          String   @default("PENDIENTE") // PENDIENTE, APROBADA, RECHAZADA
  respuestaIA     String?
  datosEjecutados Json?
  resultado       Json?
  motivoRechazo   String?
  ejecutadaAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  @@index([negocioId])
}


model Notificacion {
  id          Int      @id @default(autoincrement())
  tipo        String   // SEBASTIAN_PROPUESTA, DEUDA_ALTA, PEDIDO_PENDIENTE, etc.
  titulo      String
  mensaje     String
  leida       Boolean  @default(false)
  link        String?  // URL para navegar a la sección relevante
  datos       Json?    // Datos adicionales relacionados
  createdAt   DateTime @default(now())
  
  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  @@index([negocioId])
}

model HistorialConversacion {
  id              Int      @id @default(autoincrement())
  origen          String   // WEB, WHATSAPP
  mensajeUsuario  String
  respuestaIA     String
  accionPropuesta String?  // Acción que Sebastian propuso
  datosPropuesta  Json?    // Datos de la propuesta
  aprobado        Boolean? // null = pendiente, true = aprobado, false = rechazado
  confianza       Float?   // Nivel de confianza de Sebastian (0-1)
  createdAt       DateTime @default(now())
  
  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  @@index([origen])
  @@index([createdAt])
  @@index([negocioId])
}

model AuditoriaAcciones {
  id          Int      @id @default(autoincrement())
  usuarioId   Int?     // null si es acción anónima
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  accion      String   // Tipo de acción (CREAR_CLIENTE, EDITAR_PEDIDO, etc.)
  entidad     String   // Tipo de entidad afectada (Cliente, Pedido, Producto, etc.)
  entidadId   Int?     // ID de la entidad afectada
  descripcion String   // Descripción legible de la acción
  datosAntes  Json?    // Estado antes de la acción
  datosDespues Json?   // Estado después de la acción
  ip          String?  // IP del usuario
  userAgent   String?  // User agent del navegador
  createdAt   DateTime @default(now())
  
  negocioId Int      @default(1) // Valor por defecto para migración
  negocio   Negocio @relation(fields: [negocioId], references: [id])
  
  @@index([usuarioId])
  @@index([accion])
  @@index([createdAt])
  @@index([negocioId])
}